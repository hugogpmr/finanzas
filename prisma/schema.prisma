// Esquema de datos — ver docs/plan-tecnico.md sección 2 para el diseño original.
//
// Notas importantes:
// - Todas las tablas de usuario llevan `userId` (uuid de Supabase `auth.users`, SIN foreign key
//   porque esa tabla vive en el schema `auth`, gestionado por Supabase). RLS con
//   `user_id = auth.uid()` se añade a mano en una migración SQL (Prisma no gestiona RLS).
// - Importes monetarios: `Decimal` mapeado a `numeric(18,2)`. Tipos de cambio y cantidades de
//   activos usan más precisión decimal. Nunca Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AccountType {
  checking
  savings
  cash
  brokerage
  pension
  deposit
  crypto
  real_estate
  credit_card
  personal_loan
  mortgage
  credit_line
}

enum AccountClass {
  asset
  liability
}

enum CategoryType {
  income
  expense
  transfer
}

enum NeedsWantsSavings {
  needs
  wants
  savings
}

enum CategorizationMatchType {
  merchant_contains
  description_regex
}

enum BudgetMethod {
  fifty_thirty_twenty @map("50_30_20")
  zero_based
  envelope
  pay_yourself_first
}

enum BudgetPeriod {
  monthly
  weekly
}

enum GoalType {
  savings_goal
  emergency_fund
  sinking_fund
}

enum DebtType {
  credit_card
  personal_loan
  mortgage
  credit_line
}

enum AssetClass {
  stock
  etf
  index_fund
  pension_plan
  crypto
  bond
}

enum InvestmentTxType {
  buy
  sell
  dividend
  fee
  deposit
  withdrawal
}

// ---------------------------------------------------------------------------
// Cuentas, categorías, transacciones
// ---------------------------------------------------------------------------

model Account {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  name           String
  type           AccountType
  accountClass   AccountClass @map("account_class")
  currency       String       @db.Char(3)
  currentBalance Decimal      @default(0) @map("current_balance") @db.Decimal(18, 2)
  institution    String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  transactions           Transaction[]
  holdings               Holding[]
  debts                  Debt[]
  goals                  Goal[]
  investmentTransactions InvestmentTransaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  name              String
  parentId          String?      @map("parent_id") @db.Uuid
  type              CategoryType
  isFixed           Boolean      @default(false) @map("is_fixed")
  needsWantsSavings NeedsWantsSavings? @map("needs_wants_savings")
  icon              String?
  color             String?
  createdAt         DateTime     @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  transactions        Transaction[]
  transactionSplits   TransactionSplit[]
  categorizationRules CategorizationRule[]
  budgetLines         BudgetLine[]

  @@index([userId])
  @@index([parentId])
  @@map("categories")
}

model Tag {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @map("user_id") @db.Uuid
  name   String

  transactionTags TransactionTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TransactionTag {
  transactionId String @map("transaction_id") @db.Uuid
  tagId         String @map("tag_id") @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@map("transaction_tags")
}

model Transaction {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  categoryId        String?  @map("category_id") @db.Uuid
  amount            Decimal  @db.Decimal(18, 2)
  currency          String   @db.Char(3)
  amountEur         Decimal  @map("amount_eur") @db.Decimal(18, 2)
  fxRate            Decimal  @default(1) @map("fx_rate") @db.Decimal(18, 8)
  date              DateTime @db.Date
  merchant          String?
  description       String?
  isRecurring       Boolean  @default(false) @map("is_recurring")
  recurringGroupId  String?  @map("recurring_group_id") @db.Uuid
  isSplit           Boolean  @default(false) @map("is_split")
  transferPairId    String?  @map("transfer_pair_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  splits          TransactionSplit[]
  transactionTags TransactionTag[]

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@map("transactions")
}

model TransactionSplit {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String  @map("transaction_id") @db.Uuid
  categoryId    String? @map("category_id") @db.Uuid
  amount        Decimal @db.Decimal(18, 2)
  note          String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([transactionId])
  @@map("transaction_splits")
}

model CategorizationRule {
  id         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String                   @map("user_id") @db.Uuid
  matchType  CategorizationMatchType  @map("match_type")
  pattern    String
  categoryId String                   @map("category_id") @db.Uuid
  priority   Int                      @default(0)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("categorization_rules")
}

// ---------------------------------------------------------------------------
// Presupuestos
// ---------------------------------------------------------------------------

model Budget {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  name        String
  method      BudgetMethod
  period      BudgetPeriod
  startDate   DateTime     @map("start_date") @db.Date
  totalIncome Decimal      @map("total_income") @db.Decimal(18, 2)
  isActive    Boolean      @default(true) @map("is_active")

  lines BudgetLine[]

  @@index([userId])
  @@map("budgets")
}

model BudgetLine {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  budgetId          String  @map("budget_id") @db.Uuid
  categoryId        String  @map("category_id") @db.Uuid
  allocated         Decimal @db.Decimal(18, 2)
  rollover          Boolean @default(false)
  alertThresholdPct Decimal? @map("alert_threshold_pct") @db.Decimal(5, 2)

  budget   Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("budget_lines")
}

// ---------------------------------------------------------------------------
// Ahorro y objetivos
// ---------------------------------------------------------------------------

model Goal {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  name                String
  type                GoalType
  targetAmount        Decimal   @map("target_amount") @db.Decimal(18, 2)
  currentAmount       Decimal   @default(0) @map("current_amount") @db.Decimal(18, 2)
  targetDate          DateTime? @map("target_date") @db.Date
  linkedAccountId     String?   @map("linked_account_id") @db.Uuid
  monthlyContribution Decimal?  @map("monthly_contribution") @db.Decimal(18, 2)
  monthsOfExpenses    Int?      @map("months_of_expenses")
  createdAt           DateTime  @default(now()) @map("created_at")

  linkedAccount Account? @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("goals")
}

// ---------------------------------------------------------------------------
// Deudas
// ---------------------------------------------------------------------------

model Debt {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  accountId         String?  @map("account_id") @db.Uuid
  name              String
  debtType          DebtType @map("debt_type")
  principal         Decimal  @db.Decimal(18, 2)
  originalPrincipal Decimal  @map("original_principal") @db.Decimal(18, 2)
  interestRate      Decimal  @map("interest_rate") @db.Decimal(6, 4)
  apr               Decimal? @db.Decimal(6, 4)
  minimumPayment    Decimal  @map("minimum_payment") @db.Decimal(18, 2)
  termMonths        Int?     @map("term_months")
  startDate         DateTime @map("start_date") @db.Date
  paymentDay        Int      @map("payment_day")

  account  Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  payments DebtPayment[]

  @@index([userId])
  @@map("debts")
}

model DebtPayment {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  debtId           String   @map("debt_id") @db.Uuid
  date             DateTime @db.Date
  amount           Decimal  @db.Decimal(18, 2)
  principalPortion Decimal  @map("principal_portion") @db.Decimal(18, 2)
  interestPortion  Decimal  @map("interest_portion") @db.Decimal(18, 2)

  debt Debt @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_payments")
}

// ---------------------------------------------------------------------------
// Inversiones
// ---------------------------------------------------------------------------

model Holding {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String     @map("user_id") @db.Uuid
  accountId       String     @map("account_id") @db.Uuid
  ticker          String?
  isin            String?
  assetClass      AssetClass @map("asset_class")
  sector          String?
  geography       String?
  currency        String     @db.Char(3)
  quantity        Decimal    @default(0) @db.Decimal(18, 8)
  currentPrice    Decimal?   @map("current_price") @db.Decimal(18, 6)
  priceUpdatedAt  DateTime?  @map("price_updated_at")

  account                Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  investmentTransactions InvestmentTransaction[]
  priceSnapshots         PriceSnapshot[]

  @@index([userId])
  @@index([accountId])
  @@map("holdings")
}

model InvestmentTransaction {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  holdingId    String            @map("holding_id") @db.Uuid
  accountId    String?           @map("account_id") @db.Uuid
  type         InvestmentTxType
  date         DateTime          @db.Date
  quantity     Decimal?          @db.Decimal(18, 8)
  pricePerUnit Decimal?          @map("price_per_unit") @db.Decimal(18, 6)
  amount       Decimal           @db.Decimal(18, 2)
  currency     String            @db.Char(3)
  fee          Decimal           @default(0) @db.Decimal(18, 2)

  holding Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  account Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([holdingId])
  @@index([date])
  @@map("investment_transactions")
}

model PriceSnapshot {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  holdingId   String   @map("holding_id") @db.Uuid
  date        DateTime @db.Date
  price       Decimal  @db.Decimal(18, 6)
  marketValue Decimal  @map("market_value") @db.Decimal(18, 2)

  holding Holding @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@unique([holdingId, date])
  @@map("price_snapshots")
}

// ---------------------------------------------------------------------------
// Patrimonio neto
// ---------------------------------------------------------------------------

model NetWorthSnapshot {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  snapshotDate     DateTime @map("snapshot_date") @db.Date
  totalAssets      Decimal  @map("total_assets") @db.Decimal(18, 2)
  totalLiabilities Decimal  @map("total_liabilities") @db.Decimal(18, 2)
  netWorth         Decimal  @map("net_worth") @db.Decimal(18, 2)
  liquidNetWorth   Decimal  @map("liquid_net_worth") @db.Decimal(18, 2)
  breakdown        Json?

  @@unique([userId, snapshotDate])
  @@map("net_worth_snapshots")
}

// ---------------------------------------------------------------------------
// Divisas
// ---------------------------------------------------------------------------

model FxRate {
  id    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date  DateTime @db.Date
  base  String   @db.Char(3)
  quote String   @db.Char(3)
  rate  Decimal  @db.Decimal(18, 8)

  @@unique([date, base, quote])
  @@map("fx_rates")
}
