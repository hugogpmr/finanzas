# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase
# (Project Settings -> API para las dos siguientes, Project Settings -> Database para las de abajo).
# NUNCA subas .env a git (ya está en .gitignore). El CLI de Prisma solo lee .env,
# no .env.local, así que usamos .env para todo en este proyecto.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (Project Settings -> API -> service_role). SALTA RLS: solo
# se usa en el servidor (src/lib/supabase/service.ts), nunca en el cliente.
# Necesaria para /api/snapshot-net-worth (snapshot mensual de patrimonio neto
# de todos los usuarios).
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido con .github/workflows/net-worth-snapshot.yml (como
# secret del repo en GitHub) para que solo ese cron pueda llamar a
# /api/snapshot-net-worth. Genera uno aleatorio, p.ej. `openssl rand -hex 32`.
CRON_SECRET=

# URL pública del sitio, usada para construir el enlace de confirmación de email.
# En local: http://localhost:3000. En Vercel: la URL de producción del despliegue.
NEXT_PUBLIC_SITE_URL=

# Prisma: connection pooling (puerto 6543) para la app, y conexión directa (puerto 5432)
# para migraciones. Supabase las muestra en Project Settings -> Database -> Connection string.
DATABASE_URL=
DIRECT_URL=

# Opcional: para el botón "Actualizar precios" de /inversiones (twelvedata.com,
# plan gratis, 800 llamadas/día). Sin esta clave, los precios de las posiciones
# se pueden seguir editando a mano.
TWELVE_DATA_API_KEY=
