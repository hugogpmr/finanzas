# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase
# (Project Settings -> API para las dos siguientes, Project Settings -> Database para las de abajo).
# NUNCA subas .env a git (ya está en .gitignore). El CLI de Prisma solo lee .env,
# no .env.local, así que usamos .env para todo en este proyecto.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública del sitio, usada para construir el enlace de confirmación de email.
# En local: http://localhost:3000. En Vercel: la URL de producción del despliegue.
NEXT_PUBLIC_SITE_URL=

# Prisma: connection pooling (puerto 6543) para la app, y conexión directa (puerto 5432)
# para migraciones. Supabase las muestra en Project Settings -> Database -> Connection string.
DATABASE_URL=
DIRECT_URL=
